# ============================================================================
#  PlotBird Analytics - Apache configuration
#  Works in the document root and in a sub-directory (rules stay relative).
# ============================================================================

# No directory listings anywhere in the project.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never rewrite real files or directories: /api/collect.php, /install/ and
    # everything under /assets/ must keep working as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a route handled by the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Files that must never be served, whatever the request looks like.
# ---------------------------------------------------------------------------
<FilesMatch "(^\.|\.(?:md|json|lock|log|sql|ini|dist|sample\.php)$|composer\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The configuration file holds database credentials.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
<Files "config.local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# ---------------------------------------------------------------------------
# Baseline hardening. The application sends the same headers from PHP, this
# covers static files and error pages as well.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors off
    php_value upload_max_filesize 8M
</IfModule>

# ---------------------------------------------------------------------------
# Caching for the static assets. The version query string (?v=) makes long
# lifetimes safe: a new release changes the URL.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
