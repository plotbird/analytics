# Templates are included by PHP with their variables already prepared.
# Requesting one directly would only produce notices, but there is no reason
# to allow it at all.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
